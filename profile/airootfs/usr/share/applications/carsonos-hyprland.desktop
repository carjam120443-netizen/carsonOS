[Desktop Entry]
Type=Application
Name=Restore Hyprland Configuration
Comment=Restore CarsonOS Hyprland settings and enable the LightDM session chooser
Exec=xfce4-terminal --hold --title=CarsonOS-Hyprland --command=carsonos-hyprland
Icon=preferences-desktop-display
Terminal=false
Categories=System;Settings;
StartupNotify=true
