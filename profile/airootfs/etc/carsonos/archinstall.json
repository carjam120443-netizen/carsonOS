{
  "archinstall_language": "English",
  "network_config": {
    "type": "nm"
  },
  "packages": [
    "networkmanager",
    "network-manager-applet",
    "hyprland",
    "waybar",
    "wofi",
    "kitty",
    "hyprpaper",
    "hypridle",
    "hyprlock",
    "swaync",
    "cliphist",
    "xdg-desktop-portal",
    "xdg-desktop-portal-hyprland",
    "xdg-desktop-portal-gtk",
    "polkit-kde-agent",
    "qt5-wayland",
    "qt6-wayland",
    "grim",
    "slurp",
    "wl-clipboard",
    "brightnessctl",
    "playerctl",
    "wlogout",
    "nwg-look",
    "ttf-jetbrains-mono-nerd",
    "cinnamon",
    "cinnamon-translations",
    "nemo",
    "xorg-server",
    "lightdm",
    "lightdm-gtk-greeter",
    "pipewire",
    "pipewire-pulse",
    "wireplumber",
    "xdg-user-dirs",
    "xdg-utils",
    "gvfs",
    "thunar",
    "firefox",
    "fastfetch",
    "exfat-utils",
    "man-pages-utils",
    "arch-wiki-lite"
  ],
  "services": [
    "NetworkManager.service",
    "lightdm.service",
    "systemd-timesyncd.service"
  ],
  "profile_config": {
    "gfx_driver": "All open-source",
    "greeter": "lightdm-gtk-greeter",
    "profile": {
      "main": "Desktop",
      "details": [
        "Hyprland"
      ],
      "custom_settings": {
        "Hyprland": {
          "seat_access": "polkit"
        }
      }
    }
  },
  "custom_commands": [
    "install -d -m 0755 /etc/lightdm/lightdm.conf.d && printf '[Seat:*]\\nuser-session=hyprland\\ngreeter-session=lightdm-gtk-greeter\\n' > /etc/lightdm/lightdm.conf.d/50-carsonos.conf",
    "systemctl enable NetworkManager.service lightdm.service systemd-timesyncd.service",
    "systemctl set-default graphical.target"
  ],
  "ntp": true
}
