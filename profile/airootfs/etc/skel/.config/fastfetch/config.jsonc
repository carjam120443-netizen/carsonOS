{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/carsonos.txt",
    "color": {
      "1": "green"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "green",
      "title": "green"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk"
  ]
}
